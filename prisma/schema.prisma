generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String      @id @default(cuid())
  name              String?
  email             String      @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String?
  activeWorkspaceId String?
  accounts          Account[]
  sessions          Session[]
  resetTokens       PasswordResetToken[]
  aiProviders       UserAiProvider[]
  agentSkills       UserAgentSkill[]
  aiUsageLogs       AiUsageLog[]
  agentSessions     AgentSession[]
  workspaces        Workspace[]
  activeWorkspace   Workspace?  @relation("ActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model UserAiProvider {
  id           String   @id @default(cuid())
  userId       String
  providerKey  String
  defaultModel String?
  baseUrl      String?
  isDefault    Boolean  @default(false)
  apiTokenEnc  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerKey])
  @@index([userId])
}

model UserAgentSkill {
  id          String               @id @default(cuid())
  userId      String
  name        String
  slug        String
  instruction String               @db.Text
  metricKeys  WorkspaceMetricKey[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, slug])
  @@index([userId])
}

model Workspace {
  id                  String   @id @default(cuid())
  userId              String
  name                String
  nameKey             String
  siteUrl             String
  vtexAccountName     String?
  vtexEnvironment     String?
  vtexAppKeyEnc       String?  @db.Text
  vtexAppTokenEnc     String?  @db.Text
  clarityTokenEnc     String?  @db.Text
  gaServiceAccountEnc String?  @db.Text
  gaClientEmail       String?
  gaPropertyId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeForUsers User[]                  @relation("ActiveWorkspace")
  observability  WorkspaceObservability?
  metricTargets  WorkspaceMetricTarget[]
  metricSnapshots WorkspaceMetricSnapshot[]
  metricDays     WorkspaceMetricDay[]
  claritySnapshots WorkspaceClaritySnapshot[]
  analysis            WorkspaceAnalysis?
  pageAudits          WorkspacePageAudit[]
  seoChecklistItems   WorkspaceSeoChecklistItem[]
  agentSessions       AgentSession[]

  @@unique([userId, nameKey])
  @@index([userId])
}

enum WorkspaceAnalysisStatus {
  measured
  complete
  narrative_failed
}

enum AiUsagePurpose {
  analysis
  agent
  page_audit
}

enum AgentChatMode {
  agent
  plan
  ask
}

enum AgentMessageRole {
  user
  assistant
}

enum AgentModelSource {
  user_provider
  platform
  browser
}

model AgentSession {
  id              String         @id @default(cuid())
  userId          String
  workspaceId     String?
  mode            AgentChatMode  @default(agent)
  title           String         @default("Nova conversa")
  lastModelSource AgentModelSource?
  lastProviderKey String?
  lastModel       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  messages  AgentMessage[]

  @@index([userId, updatedAt])
  @@index([workspaceId])
}

model AgentMessage {
  id          String           @id @default(cuid())
  sessionId   String
  role        AgentMessageRole
  content     String           @db.Text
  partsJson   Json?
  modelSource AgentModelSource?
  providerKey String?
  model       String?
  createdAt   DateTime         @default(now())

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model WorkspaceAnalysis {
  id              String                  @id @default(cuid())
  workspaceId     String                  @unique
  periodStart     DateTime
  periodEnd       DateTime
  periodLabel     String
  overallScore    Int?
  overallStatus   String
  measurementJson Json
  narrativeJson   Json?
  status          WorkspaceAnalysisStatus
  aiProviderKey   String?
  aiModel         String?
  aiRoute         String?
  collectedAt     DateTime
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum PageAuditRole {
  home
  category
  product
  search
}

enum SeoChecklistItemStatus {
  pending
  done
  not_applicable
}

model WorkspacePageAudit {
  id            String                  @id @default(cuid())
  workspaceId   String
  role          PageAuditRole
  url           String
  reportJson    Json
  narrativeJson Json?
  status        WorkspaceAnalysisStatus
  aiProviderKey String?
  aiModel       String?
  aiRoute       String?
  collectedAt   DateTime
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, role])
  @@index([workspaceId])
}

model WorkspaceSeoChecklistItem {
  id          String                 @id @default(cuid())
  workspaceId String
  itemKey     String
  status      SeoChecklistItemStatus @default(pending)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, itemKey])
  @@index([workspaceId])
}

model AiUsageLog {
  id           String         @id @default(cuid())
  userId       String
  workspaceId  String
  purpose      AiUsagePurpose
  route        String
  providerKey  String?
  model        String?
  createdAt    DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

enum WorkspaceMetricPeriodType {
  week
  month
}

enum WorkspaceMetricKey {
  vtex_revenue
  vtex_orders
  ga4_sessions
  ga4_conversion_pct
  gsc_clicks
  clarity_sessions
  clarity_dead_clicks
  clarity_quick_backs
}

enum WorkspaceMetricSourceStatus {
  ok
  failed
  missing
}

model WorkspaceMetricTarget {
  id           String                    @id @default(cuid())
  workspaceId  String
  metricKey    WorkspaceMetricKey
  periodType   WorkspaceMetricPeriodType
  targetValue        Decimal                   @db.Decimal(18, 4)
  minExpectedValue   Decimal?                  @db.Decimal(18, 4)
  createdAt          DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, metricKey, periodType])
  @@index([workspaceId])
}

model WorkspaceMetricSnapshot {
  id                    String                    @id @default(cuid())
  workspaceId           String
  periodType            WorkspaceMetricPeriodType
  periodStart           DateTime
  periodEnd             DateTime
  capturedOn            DateTime                  @db.Date
  collectedAt           DateTime
  vtexRevenue           Decimal?                  @db.Decimal(18, 4)
  vtexOrders            Int?
  ga4Sessions           Int?
  ga4ConversionPct      Decimal?                  @db.Decimal(8, 4)
  gscClicks             Int?
  vtexStatus            WorkspaceMetricSourceStatus
  ga4Status             WorkspaceMetricSourceStatus
  gscStatus             WorkspaceMetricSourceStatus
  vtexError             String?                   @db.Text
  ga4Error              String?                   @db.Text
  gscError              String?                   @db.Text
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodType, capturedOn])
  @@index([workspaceId, periodType])
}

model WorkspaceMetricDay {
  id              String   @id @default(cuid())
  workspaceId     String
  calendarDay     DateTime @db.Date
  vtexRevenue     Decimal? @db.Decimal(18, 4)
  vtexOrders      Int?
  ga4Sessions     Int?
  ga4Purchases    Int?
  gscClicks       Int?
  collectedAt     DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, calendarDay])
  @@index([workspaceId, calendarDay])
}

model WorkspaceClaritySnapshot {
  id            String                      @id @default(cuid())
  workspaceId   String
  capturedOn    DateTime                    @db.Date
  numOfDays     Int
  collectedAt   DateTime
  fetchedFromApi Boolean                    @default(false)
  status        WorkspaceMetricSourceStatus
  payloadJson   Json?
  error         String?                     @db.Text
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, capturedOn, numOfDays])
  @@index([workspaceId])
}

enum ObservabilityPageType {
  home
  pdp
  plp
}

model WorkspaceObservability {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  publicKey        String   @unique
  sentryProjectId  String?
  sentryProjectSlug String?
  sentryPublicKey  String?
  sentryIngestHost String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pagePatterns ObservabilityPagePattern[]

  @@index([publicKey])
}

model ObservabilityPagePattern {
  id              String                @id @default(cuid())
  observabilityId String
  pageType        ObservabilityPageType
  pathnameGlob    String
  createdAt       DateTime              @default(now())

  observability WorkspaceObservability @relation(fields: [observabilityId], references: [id], onDelete: Cascade)

  @@index([observabilityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
