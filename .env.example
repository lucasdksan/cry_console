DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# 32 bytes em base64 — ex.: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Sentry (observabilidade das lojas)
# Use um token de Internal Integration (Settings → Custom Integrations), NÃO um
# Organization Auth Token (prefixo sntrys_ — só tem org:ci e não cria projetos).
# Permissões na Internal Integration: Organization Read, Team Read, Project Admin
# e Event Read (obrigatório para a página Observabilidade — issues, vitals, replays).
SENTRY_ORG_SLUG=""
SENTRY_TEAM_SLUG=""
SENTRY_AUTH_TOKEN=""

# Gemini da plataforma (Google AI Studio)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_EMBEDDING_DIMENSION="768"
# Rate limit free tier (~100 textos/min no embedContent)
GEMINI_EMBED_BATCH_SIZE="20"
GEMINI_EMBED_PAUSE_MS="12000"

# Pinecone (base vetorial do modo Ask — Help Center VTEX)
PINECONE_API_KEY=""
PINECONE_INDEX=""
PINECONE_NAMESPACE="vtex-help-pt"
# Indexação Help Center (scripts/index-vtex-help.ts): VTEX_HELP_SKIP_DISCOVER=1 reutiliza tmp/vtex-help-links.json; VTEX_HELP_FULL_REINDEX=1 ignora progresso e re-scrapeia tudo; VTEX_HELP_FORCE_UPSERT=1 re-embeda mesmo chunks idênticos no Pinecone

# PageSpeed Insights (auditoria SEO/CRO por URL — opcional, cota menor sem chave)
PAGESPEED_API_KEY=""
